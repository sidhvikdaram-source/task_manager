rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Replaced with the dedicated restricted identity only after authorization.
    function relayProcessor() {
      return signedIn() && request.auth.uid == 'N26IQE95a1cUVhHS34DS2QONdmB2';
    }

    match /aiRelayConfig/default {
      allow read: if signedIn();
      allow write: if false;
    }

    match /aiRelayLimits/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && !relayProcessor() &&
        request.resource.data.keys().hasOnly(['jobId','updatedAt']) &&
        request.resource.data.jobId is string &&
        request.resource.data.updatedAt == request.time &&
        (!exists(/databases/$(database)/documents/aiRelayLimits/$(uid)) ||
          request.time >= resource.data.updatedAt + duration.value(10, 's'));
      allow delete: if false;
    }

    match /aiRelayJobs/{jobId} {
      allow read: if relayProcessor() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && !relayProcessor() &&
        get(/databases/$(database)/documents/aiRelayConfig/default).data.enabled == true &&
        request.resource.data.keys().hasOnly(['ownerUid','mode','inputJson','status','createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.mode in ['task','general'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/aiRelayLimits/$(request.auth.uid)).data.jobId == jobId &&
        getAfter(/databases/$(database)/documents/aiRelayLimits/$(request.auth.uid)).data.updatedAt == request.time &&
        request.resource.data.inputJson is string &&
        request.resource.data.inputJson.size() <= 450000;
      allow update: if relayProcessor() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.mode == resource.data.mode &&
        request.resource.data.inputJson == resource.data.inputJson &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','responseStatus','responseType','responseText','error'
        ]) && request.resource.data.status in ['processing','done','failed'];
      allow delete: if relayProcessor() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    function approvedAdmin() {
      return signedIn() && request.auth.token.email in [
        'sidhvik.daram@gmail.com',
        'sidhvik.daram@k12.friscoisd.org'
      ];
    }

    function safeAdminState(data) {
      return approvedAdmin() || (
        data.isAdmin == false &&
        data.adminModeEnabled == false &&
        data.adminChestCount == 0
      );
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && safeAdminState(request.resource.data);
      allow update: if owns(uid) && safeAdminState(request.resource.data);
      allow delete: if owns(uid);

      match /{collectionName}/{documentId} {
        allow read, write: if owns(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn() && (owns(uid) || resource.data.socialEnabled == true);
      allow create, update: if owns(uid) && request.resource.data.id == uid;
      allow delete: if owns(uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.participants.hasAll([
          request.resource.data.requesterId,
          request.resource.data.recipientId
        ]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.recipientId == resource.data.recipientId;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.conversationId == resource.data.conversationId;
      allow delete: if signedIn() && request.auth.uid == resource.data.senderId;
    }

    match /blocks/{blockId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.blockerId;
      allow read, delete: if signedIn() && request.auth.uid == resource.data.blockerId;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if approvedAdmin();
    }
  }
}
