{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "artifacts/api-server/dist/index.mjs": {
      "runtime": "vercel-node@latest"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/dist/index.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "artifacts/api-server/dist/index.mjs"
    }
  ]
}
