{
  "name": "nimbus-ai",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "services": [{ "binding": "RELAY_PROCESSOR", "service": "nimbus-ai" }],
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "GENERAL_AI_PROVIDER": "groq",
    "FIREBASE_PROJECT_ID": "nimbusdo",
    "FIREBASE_RELAY_UID": "N26IQE95a1cUVhHS34DS2QONdmB2",
    "FIREBASE_PUBLIC_API_KEY": "AIzaSyCCfJmrl4wcBgqK2HWkonfsvYPriMbmV2c",
    "ALLOWED_ORIGIN": "https://nimbusdo.web.app",
    "ALLOWED_ORIGINS": "https://nimbusdo.web.app,https://nimbusdo.firebaseapp.com",
  },
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
}
