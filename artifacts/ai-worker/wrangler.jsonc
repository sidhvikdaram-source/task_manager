{
  "name": "nimbus-ai",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "FIREBASE_PROJECT_ID": "nimbusdo",
    "ALLOWED_ORIGIN": "https://nimbusdo.web.app",
    "ALLOWED_ORIGINS": "https://nimbusdo.web.app,https://nimbusdo.firebaseapp.com",
  },
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
}
